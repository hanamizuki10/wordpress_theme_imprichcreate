{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.4",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_DISPLAY": true,
				"WP_DEBUG_LOG": "/playground/logs/debug.log"
			}
		},
		{
			"step": "activateTheme",
			"themeFolderName": "imprichcreate"
		},
		{
			"step": "runPHP",
			"code": "<?php require '/playground/seed.php';"
		}
	]
}
